# ==============================================================================
# Prarush Platform Environment Configuration (Optional)
# ==============================================================================
# You can provide default API keys here or through Vercel Environment Variables.
# Keys defined here will automatically activate live AI inference across all
# features in the app (AI Assistant, Content Studio, Document Intelligence,
# Knowledge Hub RAG, and Workflow Automations) if not overridden in browser BYOK settings.
# ==============================================================================

# Anthropic Claude (Sonnet 5.5, Sonnet 5, Sonnet 4.5)
# Obtain from: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, DALL-E 3, Whisper)
# Obtain from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Google Gemini (Gemini 3.8 Flash, 2.5 Pro)
# Obtain from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenRouter (Meta Llama 3.3 70B & Open Weights)
# Obtain from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
