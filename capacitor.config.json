{
  "appId": "com.prarush.app",
  "appName": "Prarush",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#060911",
      "showSpinner": true,
      "spinnerColor": "#06b6d4"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#060911"
    }
  }
}
