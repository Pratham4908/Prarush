{
  "appId": "com.citylife.urbanai",
  "appName": "City Life",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090d16",
      "showSpinner": true,
      "spinnerColor": "#06b6d4"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090d16"
    },
    "Geolocation": {
      "permissions": ["location", "coarseLocation"]
    }
  }
}
